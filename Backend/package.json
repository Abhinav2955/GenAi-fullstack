{
  "name": "genai-resume-backend",
  "version": "1.0.0",
  "description": "Backend API for GenAI Resume and Interview Preparation Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:prod": "NODE_ENV=production node src/db/migrate.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "resume",
    "rag",
    "genai",
    "express",
    "postgresql",
    "pgvector"
  ],
  "author": "Abhinav Prasad",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.11",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.3.0",
    "puppeteer": "^25.9.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "pg": "^8.16.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0"
  },
  "overrides": {
    "pdfjs-dist": "5.4.296"
  },
  "allowScripts": {
    "@google/genai@2.19.0": true,
    "protobufjs@7.6.6": true,
    "puppeteer@25.9.0": true,
    "tesseract.js@7.0.0": true
  }
}